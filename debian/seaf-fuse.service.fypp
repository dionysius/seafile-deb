# Please consider only editing this file through systemd drop-in files
# (e.g. `systemctl edit seaf-fuse`). This will enable you to get updates
# to this file automatically, without your overrides being lost.

# Refer to the manpage `systemd.unit` for detailed documentation on each option.
[Unit]
Description=Seafile FUSE filesystem (seaf-fuse)
Documentation=https://manual.seafile.com https://github.com/dionysius/seafile-deb
After=seafile-migrate.service
Requires=seafile-migrate.service

# Refer to the manpages `systemd.service` and `systemd.exec` for detailed documentation on each option.
[Service]
## Service execution environment
# Service configuration file.
EnvironmentFile=%E/seafile/seafile.env
# Extra fuse options, e.g. "-o allow_other" (needs user_allow_other in /etc/fuse.conf)
# to expose the mount to users other than seafile.
Environment=SEAFILE_FUSE_OPTS=
# Mountpoint %S/seafile/seafile-fuse: change ExecStart, ExecStopPost and StateDirectory together.
Type=exec
ExecStart=/usr/lib/seafile/bin/seaf-fuse -f \
  -F %E/seafile \
  -c %S/seafile/ccnet \
  -d ${SEAFILE_DATA_DIR} \
  -l - \
  $SEAFILE_FUSE_OPTS %S/seafile/seafile-fuse
# Clean up a stale mountpoint after unclean exits.
ExecStopPost=-/usr/bin/fusermount -uz %S/seafile/seafile-fuse
WorkingDirectory=/var/lib/seafile
Restart=on-failure
RestartSec=5s

## Permissions and directories
User=seafile
Group=seafile
ConfigurationDirectory=seafile::ro
ConfigurationDirectoryMode=0500
StateDirectory=seafile seafile/seafile-fuse
StateDirectoryMode=0750
UMask=0027

## Connection and process limits
LimitNOFILE=1048576
#TasksMax=128
# Customize limits to your setup and expected usage spikes.
#CPUQuota=200%
#MemoryHigh=1G
#MemoryMax=2G

## Sandboxing and isolation
# Not sandboxed: the setuid fusermount helper rules out NoNewPrivileges, and the
# mount must propagate to the host, which rules out filesystem namespacing.

[Install]
WantedBy=multi-user.target
