# Caddyfile for seafile (TLS certificates are obtained automatically for a public domain).
# The public address must match SEAFILE_SERVER_PROTOCOL/SEAFILE_SERVER_HOSTNAME and
# NOTIFICATION_SERVER_URL in /etc/seafile/seafile.env.

seafile.example.com {
	# file server; handle_path strips the path prefix
	handle_path /seafhttp/* {
		reverse_proxy 127.0.0.1:8082 {
			transport http {
				read_timeout 36000s
			}
		}
	}

	# notification server (websocket); handle_path strips the path prefix
	handle_path /notification* {
		reverse_proxy 127.0.0.1:8083
	}

	# WebDAV (seafdav.service); the path is forwarded as is, a browser's directory
	# listing loads its assets from /:dir_browser/
	redir /seafdav /seafdav/ 301
	handle /seafdav/* {
		reverse_proxy 127.0.0.1:8080 {
			transport http {
				read_timeout 1200s
			}
		}
	}
	handle /:dir_browser/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Optional: thumbnail server (package seafile-thumbnail-server), together with
	# ENABLE_THUMBNAIL_SERVER in seahub_settings.py; without it seahub serves /thumbnail/ itself
	#handle /thumbnail/* {
	#	reverse_proxy 127.0.0.1:8088
	#}

	# seahub
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
