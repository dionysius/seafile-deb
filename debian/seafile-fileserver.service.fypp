# Please consider only editing this file through systemd drop-in files
# (e.g. `systemctl edit seafile-fileserver`). This will enable you to get updates
# to this file automatically, without your overrides being lost.

# Refer to the manpage `systemd.unit` for detailed documentation on each option.
[Unit]
Description=Seafile file server (HTTP upload/download)
Documentation=https://manual.seafile.com https://github.com/dionysius/seafile-deb
PartOf=seafile.target
After=network.target seafile-server.service
Wants=seafile-server.service

# If running behind a reverse proxy - running on this system - consider ordering it before also:
#Before=nginx.service

# Refer to the manpages `systemd.service` and `systemd.exec` for detailed documentation on each option.
[Service]
## Service execution environment
# Service configuration file.
EnvironmentFile=%E/seafile/seafile.env
Type=exec
ExecCondition=/bin/sh -ec '[ "$ENABLE_GO_FILESERVER" = true ]'
ExecStart=/usr/lib/seafile/bin/fileserver \
  -F %E/seafile \
  -d ${SEAFILE_DATA_DIR} \
  -p %t/seafile
WorkingDirectory=/var/lib/seafile
Restart=on-failure
RestartSec=5s

## Permissions and directories
User=seafile
Group=seafile
ConfigurationDirectory=seafile::ro
ConfigurationDirectoryMode=0500
StateDirectory=seafile
StateDirectoryMode=0750
UMask=0027

## Connection and process limits
LimitNOFILE=1048576
#TasksMax=256
# Customize limits to your setup and expected usage spikes.
#CPUQuota=400%
# fs_cache_limit (seafile.conf, 4G by default) plus transfer buffers.
#MemoryHigh=4G
#MemoryMax=5G

## Sandboxing and isolation
# An overview is available using `systemd-analyze security <service>`.
AmbientCapabilities=
CapabilityBoundingSet=
# Uncomment these to allow binding to ports in the range 0-1024.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Process restrictions
NoNewPrivileges=true
RestrictSUIDSGID=true
SecureBits=noroot noroot-locked

# Filesystem protection
ProtectSystem=strict
ProtectHome=true
ProtectProc=noaccess
ProcSubset=pid

# Namespace isolation
PrivateTmp=disconnected
PrivateDevices=true
PrivateIPC=true
#:if SYSTEMD_MAJOR >= 258
PrivateBPF=true
#:endif

# Kernel and system protection
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict

# Execution restrictions
# The go runtime needs writable+executable memory.
MemoryDenyWriteExecute=false
SetLoginEnvironment=false

# System call and network filtering
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

# Cleanup
RemoveIPC=true

[Install]
WantedBy=seafile.target
