#!/usr/bin/env python3
# ccnet/seafile MySQL: database existence, initial schema load, versioned
# deltas, and the data's version stamp.
#
# The stamp ($SEAFILE_DATA_DIR/current_version) is the only source of truth
# for what schema version the data is at - same location/semantics as
# upstream's docker deployment, so it travels with the object store across
# relocation, restore or a docker migration. Read and written here, not by
# the caller: init/upgrade both need it to decide what to do, so splitting
# "decide" and "record" across a process boundary would just duplicate the
# version-comparison logic on both sides.
#
# Both init and upgrade go through upstream's own MySQLDBUpdater.update_ccnet_sql/
# update_seafile_sql - it takes an arbitrary sql file path, not one bound to a
# specific version directory, so there is no separate SQL-loading code of our
# own here, only which directory to point it at. Its per-statement error
# handling is intentionally left as upstream wrote it (warn and keep going,
# not fatal): a rerun after an interrupted upgrade relies on this to skip past
# already-applied statements instead of failing on them.
#
# seahub/seafevents schema is django's own (see seahub-migrate) and is never
# touched here, in either mode - only the seahub_db container itself is
# ensured to exist, since django creates tables but never the database itself.
#
# Usage: seaf-dbctl check | init | upgrade [<target-version>]
import functools
import os
import pwd
import subprocess
import sys

INSTALLDIR = "/usr/lib/seafile"


def _installed_version():
    with open(os.path.join(INSTALLDIR, "version")) as fp:
        return fp.read().strip()


def _stamp_path():
    return os.path.join(os.environ["SEAFILE_DATA_DIR"], "current_version")


def _read_stamp():
    try:
        with open(_stamp_path()) as fp:
            return fp.read().strip()
    except FileNotFoundError:
        return None


def _write_stamp(version):
    with open(_stamp_path(), "w") as fp:
        fp.write(version + "\n")


def _dpkg_cmp(a, op, b):
    return subprocess.run(["dpkg", "--compare-versions", a, op, b]).returncode == 0


def _major_minor(version):
    return ".".join(version.split(".")[:2])


def _version_sort(versions):
    def cmp(a, b):
        if _dpkg_cmp(a, "eq", b):
            return 0
        return -1 if _dpkg_cmp(a, "lt", b) else 1
    return sorted(versions, key=functools.cmp_to_key(cmp))


def _mysql_conn_kwargs(db_env_key, default_db):
    return dict(
        host=os.environ.get("SEAFILE_MYSQL_DB_HOST", "127.0.0.1"),
        port=int(os.environ.get("SEAFILE_MYSQL_DB_PORT", "3306")),
        user=os.environ.get("SEAFILE_MYSQL_DB_USER", "seafile"),
        password=os.environ.get("SEAFILE_MYSQL_DB_PASSWORD", ""),
        database=os.environ.get(db_env_key, default_db),
    )


def _ensure_database(db_env_key, default_db):
    import pymysql
    name = os.environ.get(db_env_key, default_db)
    kwargs = _mysql_conn_kwargs(db_env_key, default_db)
    kwargs.pop("database")
    con = pymysql.connect(**kwargs)
    cur = con.cursor()
    try:
        cur.execute(f"CREATE DATABASE IF NOT EXISTS `{name}` CHARACTER SET utf8mb4")
        con.commit()
        return
    except pymysql.err.OperationalError as e:
        if e.args[0] != 1044:  # not "access denied to create database"
            raise
    # no CREATE privilege - fine as long as it already exists
    cur.execute("SHOW DATABASES LIKE %s", (name,))
    if cur.fetchone() is None:
        sys.exit(
            f"ERROR: database '{name}' does not exist and {kwargs['user']} has "
            "no privilege to create it. Create it yourself, or grant CREATE. "
            "See the wiki."
        )


def ensure_databases():
    _ensure_database("SEAFILE_MYSQL_DB_CCNET_DB_NAME", "ccnet_db")
    _ensure_database("SEAFILE_MYSQL_DB_SEAFILE_DB_NAME", "seafile_db")
    _ensure_database("SEAFILE_MYSQL_DB_SEAHUB_DB_NAME", "seahub_db")


def _updater(version):
    sys.path.insert(0, os.path.join(INSTALLDIR, "upgrade"))
    import db_update_helper as h
    return h.MySQLDBUpdater(
        version,
        h.DBUpdater.get_ccnet_mysql_info(version),
        h.DBUpdater.get_seafile_mysql_info(version),
        h.DBUpdater.get_seahub_mysql_info(),
    )


def _apply_dir(updater, sql_dir):
    for name, apply_fn in (("ccnet.sql", updater.update_ccnet_sql),
                            ("seafile.sql", updater.update_seafile_sql)):
        path = os.path.join(sql_dir, name)
        if os.path.exists(path):
            apply_fn(path)


def _schema_initialised():
    import pymysql
    con = pymysql.connect(**_mysql_conn_kwargs("SEAFILE_MYSQL_DB_SEAFILE_DB_NAME", "seafile_db"))
    cur = con.cursor()
    cur.execute("SHOW TABLES")
    return cur.fetchone() is not None


def check():
    sys.exit(0 if _schema_initialised() else 1)


def init():
    if _read_stamp() is not None:
        return  # already initialised, nothing to do

    ensure_databases()

    if _schema_initialised():
        sys.exit(
            f"ERROR: {os.environ['SEAFILE_DATA_DIR']} has existing data but no "
            f"version stamp ({_stamp_path()}). There is no reliable way to "
            "tell which schema version it is at, so automatic migration is "
            "refused. If you know the seafile-server version this data was "
            f"last run against, write it verbatim to {_stamp_path()} and retry."
        )

    installed = _installed_version()
    _apply_dir(_updater(installed), os.path.join(INSTALLDIR, "sql/mysql"))
    _write_stamp(installed)


def upgrade(target=None):
    target = target or _installed_version()

    last = _read_stamp()
    if last is None:
        sys.exit(f"ERROR: no version stamp at {_stamp_path()}; run init first.")

    if last == target:
        return  # already there

    if _dpkg_cmp(target, "lt", last):
        sys.exit(
            f"ERROR: this data's version ({last}) is newer than the requested "
            f"target ({target}). The package can be downgraded, but migrating "
            f"its data backward is not supported. Reinstall seafile-server >= "
            f"{last}, or restore a backup matching {target}."
        )

    if _major_minor(last) == _major_minor(target):
        # same major.minor series: no schema change, just advance the stamp
        _write_stamp(target)
        return

    sqlroot = os.path.join(INSTALLDIR, "upgrade/sql")
    versions = os.listdir(sqlroot) if os.path.isdir(sqlroot) else []
    for vdir in _version_sort(versions):
        vmm = _major_minor(vdir)
        if not (_dpkg_cmp(vmm, "gt", _major_minor(last)) and _dpkg_cmp(vmm, "le", _major_minor(target))):
            continue
        updater = _updater(vdir)
        _apply_dir(updater, updater.sql_dir)
        _write_stamp(vdir)  # per-step: a rerun after an interruption resumes from here

    _write_stamp(target)


def main():
    if pwd.getpwuid(os.getuid()).pw_name != "seafile":
        os.execvp("runuser", ["runuser", "-u", "seafile", "--",
                               sys.executable, os.path.abspath(__file__), *sys.argv[1:]])

    args = sys.argv[1:]
    if args == ["check"]:
        check()
    elif args == ["init"]:
        init()
    elif args and args[0] == "upgrade" and len(args) <= 2:
        upgrade(args[1] if len(args) == 2 else None)
    else:
        sys.exit(f"usage: {sys.argv[0]} check|init|upgrade [<target-version>]")


if __name__ == "__main__":
    main()
