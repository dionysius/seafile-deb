#!/bin/bash
# seahub owns its own (django) schema; this only invokes its self-gating
# migration and seafevents' own table creation, never touches ccnet/seafile.
set -euo pipefail

if [ "$(id -un)" != "seafile" ]; then
    exec runuser -u seafile -- "$(readlink -f "$0")" "$@"
fi

HUB=/usr/lib/seahub

set -a; . /etc/seafile/seafile.env; set +a

cd "$HUB/seahub"
echo "seahub-migrate: applying database migrations"
"$HUB/venv/bin/python" manage.py migrate --noinput

# seahub writes activities into seafevents' tables (Activity, UserActivity, ...),
# which seafevents otherwise only creates on its own first start. The app import
# registers every model, as seafevents' own main does.
echo "seahub-migrate: creating seafevents tables"
"$HUB/venv/bin/python" -c 'import seafevents.app.app; from seafevents.db import create_db_tables; create_db_tables()'
