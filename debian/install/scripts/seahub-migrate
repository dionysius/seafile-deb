#!/bin/bash
# seahub owns its own (django) schema; this only invokes its self-gating
# migration and asset collection, never touches ccnet/seafile.
set -euo pipefail

if [ "$(id -un)" != "seafile" ]; then
    exec runuser -u seafile -- "$(readlink -f "$0")" "$@"
fi

HUB=/usr/lib/seahub

set -a; . /etc/seafile/seafile.env; set +a

cd "$HUB/seahub"
echo "seahub-migrate: applying database migrations"
"$HUB/venv/bin/python" manage.py migrate --noinput

# Builds the staticfiles manifest into STATIC_ROOT.
echo "seahub-migrate: collecting static files"
"$HUB/venv/bin/python" manage.py collectstatic --noinput -i admin

# The default avatars are served from the avatars directory; refreshed on every run.
mkdir -p "$SEAHUB_DATA_DIR/avatars"
cp -r --no-preserve=all "$HUB/seahub/media/avatars/." "$SEAHUB_DATA_DIR/avatars/"
