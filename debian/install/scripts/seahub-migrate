#!/bin/bash
# seahub owns its own (django) schema; this only invokes its self-gating
# migration, never touches ccnet/seafile.
set -euo pipefail

if [ "$(id -un)" != "seafile" ]; then
    exec runuser -u seafile -- "$(readlink -f "$0")" "$@"
fi

HUB=/usr/lib/seahub

set -a; . /etc/seafile/seafile.env; set +a

cd "$HUB/seahub"
echo "seahub-migrate: applying database migrations"
"$HUB/venv/bin/python" manage.py migrate --noinput
