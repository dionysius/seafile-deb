#!/bin/bash
# seahub's schema comes from upstream's sql (see seaf-dbctl); this only lets
# seafevents create its own tables, which seahub writes into (Activity,
# UserActivity, ...) before seafevents' first start would otherwise do so.
# The app import registers every model, as seafevents' own main does.
set -euo pipefail

if [ "$(id -un)" != "seafile" ]; then
    exec runuser -u seafile -- "$(readlink -f "$0")" "$@"
fi

HUB=/usr/lib/seahub

set -a; . /etc/seafile/seafile.env; set +a

cd "$HUB/seahub"
echo "seahub-migrate: creating seafevents tables"
"$HUB/venv/bin/python" -c 'import seafevents.app.app; from seafevents.db import create_db_tables; create_db_tables()'
