+void
+seaf_notify_ready (void)
+{
+    const char *path = g_getenv ("NOTIFY_SOCKET");
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    size_t len;
+    int fd;
+
+    if (!path || !*path)
+        return;
+    len = strlen (path);
+    if ((path[0] != '/' && path[0] != '@') || len >= sizeof (addr.sun_path)) {
+        seaf_warning ("Invalid NOTIFY_SOCKET: %s.\n", path);
+        return;
+    }
+    memcpy (addr.sun_path, path, len);
+    if (path[0] == '@')
+        addr.sun_path[0] = '\0';
+
+    fd = socket (AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return;
+    if (sendto (fd, "READY=1", 7, 0, (struct sockaddr *) &addr,
+                offsetof (struct sockaddr_un, sun_path) + len) < 0)
+        seaf_warning ("Failed to notify systemd: %s.\n", strerror (errno));
+    close (fd);
+}
