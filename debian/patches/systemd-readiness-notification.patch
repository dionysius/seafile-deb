--- a/seafevents/main.py
+++ b/seafevents/main.py
@@ -1,5 +1,6 @@
 # -*- coding: utf-8 -*-
 import os
+import socket
 import logging
 import argparse
 
@@ -12,6 +13,21 @@ from seafevents.app.signal_handler import set_signal
 
 
 
+def notify_ready():
+    """Tell systemd the service is ready (sd_notify protocol), if it asked for it."""
+    addr = os.environ.get('NOTIFY_SOCKET')
+    if not addr:
+        return
+    if addr[0] == '@':
+        addr = '\0' + addr[1:]
+    try:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
+            sock.connect(addr)
+            sock.sendall(b'READY=1')
+    except OSError as e:
+        logging.warning('Failed to notify systemd: %s', e)
+
+
