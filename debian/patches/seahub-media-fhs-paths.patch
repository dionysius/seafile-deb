+        # the shipped default avatars; uploaded ones are in SEAHUB_DATA_ROOT
+        re_path(r'^%s/(?P<path>avatars/(groups/)?default[^/]*)$' % (media_url), static_view,
+            {'document_root': settings.MEDIA_ROOT}),
+        re_path(r'^%s/(?P<path>(avatars|custom)/.*)$' % (media_url), static_view,
