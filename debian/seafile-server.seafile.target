# Bundles the server's units: seafile-server, seafile-fileserver,
# seafile-notification, seahub and seafevents. Starting this target starts the
# enabled ones; stopping or restarting it reaches all of them. seafdav and
# seafile-fuse are standalone, enable and manage them on their own.

# Refer to the manpages `systemd.target` and `systemd.unit` for detailed documentation on each option.
[Unit]
Description=Seafile server
Documentation=https://manual.seafile.com https://github.com/dionysius/seafile-deb
# The members order themselves after this target instead of the default reverse,
# so stopping it returns once they are all stopped.
DefaultDependencies=no

[Install]
WantedBy=multi-user.target
