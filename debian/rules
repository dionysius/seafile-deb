#!/usr/bin/make -f

include /usr/share/dpkg/default.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# the bundled libevhtp (K&R-style API, oniguruma) does not compile under C23 (gcc >= 15)
export DEB_CFLAGS_MAINT_APPEND = -std=gnu17

export DH_VERBOSE = 1
MAKEFLAGS += --no-print-directory

# common locations
TMPDEB = $(CURDIR)/debian/tmp
# self-contained daemon prefix
SEAFPREFIX = /usr/lib/seafile
# seahub application tree
HUBPREFIX = /usr/lib/seahub
# throwaway prefix for the statically linked libevhtp
STAGING = $(CURDIR)/debian/staging
# staged seahub tree: the application and the venv
HUBDEST = $(TMPDEB)$(HUBPREFIX)
SEAHUB = $(HUBDEST)/seahub
VENV = $(HUBDEST)/venv
VENVSITE = $(VENV)/lib/python3*/site-packages

# steps imitate upstream's community build recipe:
# https://github.com/haiwen/seafile-docker/tree/master/build/seafile_14.0

# uv (not packaged in debian) builds seahub's python deps
UV_VERSION = 0.11.26
UV_SHA256_x86_64 = 6426a73c3837e6e2483ee344cbc00f36394d179afcba6183cb77437e67db4af0
UV_SHA256_aarch64 = befa1a59c91e96eb601b0fd9a97c03dd666f17baba644b2b4db9c59a767e387e
UV = $(CURDIR)/debian/.buildbin/uv
# the venv must match the runtime interpreter; cache inside the build tree, real
# copies since that cache is thrown away
export UV_PYTHON_PREFERENCE = only-system
export UV_LINK_MODE = copy
export UV_CACHE_DIR = $(CURDIR)/debian/.uvcache

# keep npm's cache inside the build tree
export npm_config_cache = $(CURDIR)/debian/.npmcache

# --with-mysql helper
MARIADB_CONFIG := $(or $(wildcard /usr/bin/mariadb_config),/usr/bin/mysql_config)

# go: caches inside the build tree, no toolchain downloads
export GOFLAGS = -mod=mod -trimpath
export GOCACHE = $(CURDIR)/debian/.gocache
export GOMODCACHE = $(CURDIR)/debian/.gomodcache
export GOTOOLCHAIN = local

# make the staged libevhtp discoverable
export CPPFLAGS += -I$(STAGING)/include
export LDFLAGS += -L$(STAGING)/lib
export PKG_CONFIG_PATH := $(STAGING)/lib/pkgconfig:$(PKG_CONFIG_PATH)
export PATH := $(CURDIR)/debian/.buildbin:$(PATH)

JOBS = $(or $(DEB_BUILD_OPTION_PARALLEL),1)

# systemd major version for service file templating (systemd.pc from systemd-dev)
SYSTEMD_MAJOR := $(shell pkgconf --modversion systemd)

# units generated from debian/*.service.fypp; the bundle's members are wanted by seafile.target
BUNDLE_UNITS = seaf-server seaf-fileserver seaf-notification-server seahub seafevents seafdav
SERVER_UNITS = seafile-migrate $(BUNDLE_UNITS)

# python install dir: upstream expects the versionless lib/python3/site-packages layout
PYSEAF = $(SEAFPREFIX)/lib/python3/site-packages

# statically linked go binaries: record the go toolchain source in Built-Using
BUILT_USING = $(shell dpkg-query -f '$${source:Package} (= $${source:Version})' -W $$(dpkg-query -S "$$(go env GOROOT)/bin/go" | cut -d: -f1))
# seahub's venv is compiled for the distribution python; pin the runtime to that minor
PY3_MINOR = $(shell python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
PY3_NEXT = $(shell python3 -c 'import sys; print("%d.%d" % (sys.version_info[0], sys.version_info[1] + 1))')

%:
	dh $@

override_dh_auto_clean:
# go marks its module cache read-only, so make it writable before removing
	chmod -R u+w debian/.gocache debian/.gomodcache 2>/dev/null || true
	rm -rf $(STAGING) debian/.gocache debian/.gomodcache debian/.buildbin debian/.uvcache debian/.npmcache
	[ ! -f Makefile ] || $(MAKE) distclean || true
	rm -f fileserver/fileserver notification-server/notification-server
	rm -f debian/seafile-server.*.service debian/seafile-fuse.*.service debian/uv.tar.gz
	rm -rf seahub/frontend/node_modules seahub/frontend/build seahub/frontend/webpack-stats.json seahub/media/assets

override_dh_auto_configure-arch:
	mkdir -p $(STAGING) debian/.buildbin
# upstream invokes searpc-codegen.py; debian ships it as searpc-codegen
	ln -sf /usr/bin/searpc-codegen debian/.buildbin/searpc-codegen.py

# libevhtp (static, SSL unused); cmake 4 rejects its cmake_minimum_required(2.8)
	cd libevhtp && cmake -DEVHTP_DISABLE_SSL=ON -DEVHTP_BUILD_SHARED=OFF \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_INSTALL_PREFIX=$(STAGING) -DCMAKE_INSTALL_LIBDIR=lib .
	$(MAKE) -C libevhtp -j$(JOBS)
	$(MAKE) -C libevhtp install

# seafile-server (the source root)
	./autogen.sh
	./configure --prefix=$(SEAFPREFIX) --with-mysql=$(MARIADB_CONFIG)

override_dh_auto_configure-indep:
# Build-Depends cannot express "nodejs with npm" (nodesource bundles it, debian splits it)
	@command -v npm >/dev/null || { \
		echo "ERROR: npm not found. Install nodejs from nodesource (bundles npm)"; \
		echo "or your distribution's npm package."; exit 1; }

override_dh_auto_build-arch:
# lib/'s two valac rules write the same generated sources and race under -j
	$(MAKE) -j1 -C lib gensource
	$(MAKE) -j$(JOBS)

# go components, each its own module
	cd fileserver && go build -o fileserver .
	cd notification-server && go build -o notification-server .

# fetch uv (build-only)
	curl -sSL https://github.com/astral-sh/uv/releases/download/$(UV_VERSION)/uv-$(DEB_BUILD_GNU_CPU)-unknown-$(DEB_BUILD_ARCH_OS)-$(DEB_BUILD_ARCH_LIBC).tar.gz -o debian/uv.tar.gz
	echo "$(UV_SHA256_$(DEB_BUILD_GNU_CPU)) debian/uv.tar.gz" | sha256sum -c -
	mkdir -p debian/.buildbin
	tar --strip-components=1 -C debian/.buildbin -xzf debian/uv.tar.gz uv-$(DEB_BUILD_GNU_CPU)-unknown-$(DEB_BUILD_ARCH_OS)-$(DEB_BUILD_ARCH_LIBC)/uv

# seahub frontend (webpack). CI=false keeps warnings non-fatal; source maps are
# unused and memory-hungry. Skipped if already built (dh_auto_clean removes the output).
override_dh_auto_build-indep:
	if [ ! -d seahub/frontend/build/frontend ]; then \
		cd seahub/frontend && npm ci --no-audit --no-fund && \
		CI=false GENERATE_SOURCEMAP=false NODE_OPTIONS=--max-old-space-size=4096 npm run build; \
	fi

override_dh_auto_test:

# dwz cannot process the go binaries' compressed DWARF nor the prebuilt venv wheels
override_dh_dwz:
	dh_dwz -Xfileserver -Xnotification-server -Xseahub/venv

# prebuilt third-party wheels are not ours to strip (objcopy also chokes on some)
override_dh_strip:
	dh_strip -Xseahub/venv

# the venv's shared objects are private, no ldconfig trigger
override_dh_makeshlibs:
	dh_makeshlibs -Xseahub/venv

# upstream ships modules, templates and media with the executable bit
execute_after_dh_fixperms-indep:
	find debian/seafile-server-data/usr/lib/seahub -type f -perm /111 \
		-exec sh -c 'for f; do [ "$$(head -c2 "$$f")" = "#!" ] || chmod a-x "$$f"; done' sh {} +

override_dh_auto_install-arch:
	$(MAKE) install DESTDIR=$(TMPDEB) pythondir=$(PYSEAF) pyexecdir=$(PYSEAF)

# drop the go binaries next to the C daemons
	install -m 0755 fileserver/fileserver $(TMPDEB)$(SEAFPREFIX)/bin/fileserver
	install -m 0755 notification-server/notification-server $(TMPDEB)$(SEAFPREFIX)/bin/notification-server

# migration assets: base schema, per-version upgrade deltas, dispatcher, version stamp
	cp -a scripts/sql $(TMPDEB)$(SEAFPREFIX)/sql
	cp seahub/sql/mysql.sql $(TMPDEB)$(SEAFPREFIX)/sql/mysql/seahub.sql
	cp -a seahub/scripts/upgrade $(TMPDEB)$(SEAFPREFIX)/upgrade
# only db_update_helper.py and the sql/ deltas are used; the .sh wrappers assume
# upstream's own multi-version install tree
	find $(TMPDEB)$(SEAFPREFIX)/upgrade -maxdepth 1 -name '*.sh' -delete
	echo "$(DEB_VERSION_UPSTREAM)" > $(TMPDEB)$(SEAFPREFIX)/version

# static/dev artefacts, the upstream supervisor and its setup helpers; systemd runs the daemons directly
	rm -rf $(TMPDEB)$(SEAFPREFIX)/include
	find $(TMPDEB)$(SEAFPREFIX) -name '*.la' -delete
	rm -f $(TMPDEB)$(SEAFPREFIX)/bin/seafile-controller $(TMPDEB)$(SEAFPREFIX)/bin/seafile-admin \
		$(TMPDEB)$(SEAFPREFIX)/bin/parse_seahub_db.py

# synthesize a project from the merged upstream requirements (minus the bundled
# components), lock it and compile a relocatable venv - nothing to resolve at runtime
	mkdir -p $(HUBDEST)
	{ echo '[project]'; echo 'name = "seahub-deps"'; echo 'version = "0"'; \
	  echo 'requires-python = ">=3.11"'; echo 'dependencies = ['; \
	  cat seahub/requirements.txt seafevents/requirements.txt seafdav/requirements.txt \
	    | grep -viE '^[[:space:]]*(#|wsgidav|seafobj|pillow-heif|scikit-learn|$$)' | sed 's/.*/  "&",/'; \
	  echo '  "pyOpenSSL>=24",'; \
	  echo '  "pillow-heif>=1.1",'; \
	  echo '  "django-pylibmc>=0.6",'; \
	  echo ']'; } > $(HUBDEST)/pyproject.toml
# pyOpenSSL floor: uv otherwise resolves a 22.x incompatible with current cryptography
# pillow-heif floor: upstream's ==1.0.* pin neither ships wheels nor builds for current pythons
# scikit-learn left out: only face recognition's clustering uses it, which needs the separate
# metadata and Seafile AI servers
# django-pylibmc: seahub/settings.py's CACHE_PROVIDER=memcached backend, declared as a
# dependency in none of the three requirements.txt above
# libmemcached-dev (Build-Depends) is only for this step: uv still builds django-pylibmc's
# own pylibmc dependency from source here even though it's discarded and replaced below
	cd $(HUBDEST) && $(UV) lock --python python3
	$(UV) venv --relocatable --python python3 $(VENV)
	cd $(HUBDEST) && UV_PROJECT_ENVIRONMENT=$(VENV) \
		$(UV) sync --frozen --no-dev --inexact
# self-contained venv (system site-packages would leak conflicts); bundle the
# pure-python pysearpc, seaserv comes via PYTHONPATH in the units
	cp -a /usr/lib/python3/dist-packages/pysearpc \
		$(VENVSITE)/
# pylibmc's PyPI build (whether wheel or source) hits a CPython 3.13 C-API
# incompatibility that spams ignored-exception tracebacks on every use; Debian's
# own build doesn't, so replace django-pylibmc's copy with it
	rm -rf $(VENVSITE)/pylibmc \
		$(VENVSITE)/pylibmc-*.dist-info \
		$(VENVSITE)/_pylibmc.cpython-*.so
	cp -a /usr/lib/python3/dist-packages/pylibmc \
		/usr/lib/python3/dist-packages/_pylibmc.cpython-*.so \
		/usr/lib/python3/dist-packages/pylibmc-*.egg-info \
		$(VENVSITE)/

# third-party license inventory: the linked go modules and the compiled venv
	mkdir -p $(TMPDEB)/usr/share/doc/seafile-server
	{ debian/helpers/third-party-go.sh fileserver notification-server; \
	  $(VENV)/bin/python debian/helpers/third-party-python.py; } \
		| gzip -9n > $(TMPDEB)/usr/share/doc/seafile-server/THIRD-PARTY-LICENSES.txt.gz

# build-only leftovers: bytecode, the wheels' test suites, type stubs, Cython and C sources,
# translation sources, install records, the console scripts nothing calls (the units run
# python and gunicorn), the synthesized project
	find $(VENV) $(TMPDEB)$(PYSEAF) -type d \( -name __pycache__ -o -name tests \) -prune -exec rm -rf {} +
	find $(VENV)/lib \( -name '*.pyi' -o -name py.typed -o -name '*.pyx' -o -name '*.pxd' -o -name '*.pxi' \
		-o -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.po' -o -path '*.dist-info/RECORD' \) -delete
# parts seahub never loads: django apps it doesn't install, the templates and static files of the
# admin and rest_framework (neither is an installed app), pycryptodome's self-test
	cd $(VENVSITE) && rm -rf django/contrib/flatpages django/contrib/gis \
		django/contrib/humanize django/contrib/postgres django/contrib/redirects django/contrib/sitemaps \
		django/contrib/syndication django/contrib/admin/static django/contrib/admin/templates \
		rest_framework/static rest_framework/templates Crypto/SelfTest
	find $(VENV)/bin -mindepth 1 ! -name 'python*' ! -name gunicorn -delete
	rm -f $(VENV)/.gitignore $(HUBDEST)/pyproject.toml $(HUBDEST)/uv.lock

# seahub tree in upstream's layout: seafdav/seafobj/objwrapper inside thirdpart,
# seafevents alongside (arch-independent, ships in seafile-server-data)
override_dh_auto_install-indep:
	mkdir -p $(HUBDEST)
	cp -a seahub $(SEAHUB)
	cp -a seafevents $(HUBDEST)/seafevents
	cp -a seafdav/wsgidav $(SEAHUB)/thirdpart/wsgidav
	cp -a seafobj/seafobj $(SEAHUB)/thirdpart/seafobj
	cp -a seafobj/objwrapper $(SEAHUB)/thirdpart/objwrapper

# third-party license inventory of the frontend
	mkdir -p $(TMPDEB)/usr/share/doc/seafile-server-data
	cd seahub/frontend && $(CURDIR)/debian/helpers/third-party-npm.py \
		| gzip -9n > $(TMPDEB)/usr/share/doc/seafile-server-data/THIRD-PARTY-LICENSES.txt.gz

# the version reported by the api and the web ui; upstream's release build stamps it the same way
	grep -q "^SEAFILE_VERSION = " $(SEAHUB)/seahub/settings.py
	sed -i "s/^SEAFILE_VERSION = .*/SEAFILE_VERSION = '$(DEB_VERSION_UPSTREAM)'/" $(SEAHUB)/seahub/settings.py

# collected static files (media/assets + staticfiles manifest), as upstream's
# release build ships them. Needs django from the venv, so an indep-only build
# (-A) cannot produce the data package. seahub's import chain requires the conf
# dirs with a seafile.conf and SEAHUB_DIR even though collectstatic uses none.
	test -x $(VENV)/bin/python || { echo "ERROR: collectstatic needs the venv from the arch build; build arch and indep together"; exit 1; }
	mkdir -p $(STAGING)/conf && printf '[database]\ntype = mysql\n' > $(STAGING)/conf/seafile.conf
	cd $(SEAHUB) && env -i PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 \
		SEAFILE_CONF_DIR=$(STAGING)/conf SEAFILE_CENTRAL_CONF_DIR=$(STAGING)/conf SEAHUB_DIR=$(SEAHUB) \
		PYTHONPATH=$(SEAHUB):$(SEAHUB)/thirdpart:$(TMPDEB)$(PYSEAF) \
		DJANGO_SETTINGS_MODULE=seahub.settings \
		$(VENV)/bin/python manage.py collectstatic --noinput -i admin -i termsandconditions

# build-only leftovers: collectstatic's sources (seahub serves the collected copies
# and reads only the webpack stats; static/ stays a STATICFILES_DIRS entry),
# translation sources, test suites, vcs files
	find $(SEAHUB)/frontend -mindepth 1 -maxdepth 1 ! -name webpack-stats.pro.json -exec rm -rf {} +
	find $(SEAHUB)/static -mindepth 1 -delete
	find $(SEAHUB) -name '*.po' -delete
	find $(SEAHUB) $(HUBDEST)/seafevents \( -name '.git*' -o -name tests.py -o -type d \( -name __pycache__ -o -name tests -o -name test \) \) \
		-prune -exec rm -rf {} +
	find $(SEAHUB)/thirdpart -type d -empty -delete

# upstream's manual-install tree: service-control scripts that would fight the
# systemd units, setup/migration/index tools, dev and CI scaffolding, wsgidav's
# sample providers and their sample TLS key. The admin tools and upgrade deltas
# this packaging uses come from the source tree (seafile-server.install,
# override_dh_auto_install-arch).
	rm -rf $(SEAHUB)/bin $(SEAHUB)/scripts $(SEAHUB)/fabfile $(SEAHUB)/tools $(SEAHUB)/.tx $(SEAHUB)/sql
	rm -rf $(SEAHUB)/thirdpart/wsgidav/samples $(SEAHUB)/thirdpart/wsgidav/server/sample_bogo_server.*
	rm -f $(SEAHUB)/.travis.yml.bak \
		$(SEAHUB)/pylintrc $(SEAHUB)/pylintrc.template \
		$(SEAHUB)/dev-requirements.txt $(SEAHUB)/test-requirements.txt \
		$(SEAHUB)/code-check.sh $(SEAHUB)/i18n.sh $(SEAHUB)/sdoc-helper.sh \
		$(SEAHUB)/HACKING $(SEAHUB)/CONTRIBUTORS \
		$(SEAHUB)/run-seahub.sh.template $(SEAHUB)/send_user_notifications.sh.template \
		$(SEAHUB)/setenv.sh.template $(SEAHUB)/Makefile $(SEAHUB)/pytest.ini \
		$(SEAHUB)/README.markdown $(SEAHUB)/requirements.txt

execute_after_dh_install-arch:
# seafile-server.install takes the whole daemon tree; seaf-fuse ships in seafile-fuse
	rm debian/seafile-server/usr/lib/seafile/bin/seaf-fuse

override_dh_installsystemd-arch:
# stopping it on upgrade would take its Requires= dependents down with it
	dh_installsystemd -pseafile-server --name=seafile-migrate --no-start --no-stop-on-upgrade seafile-migrate.service
# the bundle, installed disabled: the admin enables it once the database and secrets are
# configured. Restarting it after upgrade restarts its members in one transaction, so
# seafile-migrate runs once.
	dh_installsystemd -pseafile-server --name=seafile --no-enable --no-start --restart-after-upgrade seafile.target
	for u in $(BUNDLE_UNITS); do \
		dh_installsystemd -pseafile-server --name=$$u --no-start --no-stop-on-upgrade --no-restart-after-upgrade $$u.service || exit 1; done
# independent of seafile.target, so stopping or restarting it never unmounts
	dh_installsystemd -pseafile-fuse --name=seaf-fuse --no-enable --no-start --restart-after-upgrade seaf-fuse.service

execute_before_dh_installsystemd-arch:
	for u in $(SERVER_UNITS); do \
		fypp -DSYSTEMD_MAJOR=$(SYSTEMD_MAJOR) debian/$$u.service.fypp debian/seafile-server.$$u.service || exit 1; done
	fypp -DSYSTEMD_MAJOR=$(SYSTEMD_MAJOR) debian/seaf-fuse.service.fypp debian/seafile-fuse.seaf-fuse.service

override_dh_shlibdeps-arch:
# most venv wheels bundle private .so files dpkg-shlibdeps cannot resolve: skip the
# venv, but feed the source-compiled wheels that link system libraries into the same
# run (a second dpkg-shlibdeps run replaces shlibs:Depends instead of extending it)
	dh_shlibdeps -pseafile-server -Xseahub/venv -- \
		$$(find debian/seafile-server$(HUBPREFIX)/venv \( -name '_mysql*.so' -o -name '_ldap*.so' -o -name '_pylibmc*.so' \) -printf '-e%p ')
	dh_shlibdeps -pseafile-fuse

override_dh_gencontrol:
	dh_gencontrol -- -Vmisc:Built-Using='$(BUILT_USING)' \
		-V'python3:Depends=python3 (>= $(PY3_MINOR)), python3 (<< $(PY3_NEXT))'
