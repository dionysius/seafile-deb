# Please consider only editing this file through systemd drop-in files
# (e.g. `systemctl edit seafdav`). This will enable you to get updates
# to this file automatically, without your overrides being lost.

# Refer to the manpage `systemd.unit` for detailed documentation on each option.
[Unit]
Description=Seafile WebDAV server (seafdav)
Documentation=https://manual.seafile.com https://github.com/dionysius/seafile-deb
After=network.target seafile.service seafile-migrate.service
Requires=seafile-migrate.service
Wants=seafile.service

# If running behind a reverse proxy - running on this system - consider ordering it before also:
#Before=nginx.service

# Refer to the manpages `systemd.service` and `systemd.exec` for detailed documentation on each option.
[Service]
## Service execution environment
# Service configuration file.
EnvironmentFile=%E/seafile/seafile.env
# share_name, workers, timeout and show_repo_id are read from seafdav.conf.
Environment=SEAFDAV_CONF=%E/seafile/seafdav.conf
Type=exec
# Upstream's controller passes the listen address on the command line; seafdav
# itself never reads it from seafdav.conf. --root only satisfies the cli's
# provider check, the seafile provider replaces that mapping right after.
ExecStart=/usr/lib/seahub/venv/bin/python -m wsgidav.server.server_cli \
  --server gunicorn \
  --root / \
  --host 127.0.0.1 \
  --port 8080
WorkingDirectory=/usr/lib/seahub/seahub
Restart=on-failure
RestartSec=5s

## Permissions and directories
User=seafile
Group=seafile
ConfigurationDirectory=seafile::ro
ConfigurationDirectoryMode=0500
StateDirectory=seafile
StateDirectoryMode=0750
UMask=0027

## Connection and process limits
#TasksMax=128
# Customize limits to your setup and expected usage spikes; memory scales with
# the threads (workers in seafdav.conf) and concurrent transfers.
#CPUQuota=200%
#MemoryHigh=512M
#MemoryMax=1G

## Sandboxing and isolation
# An overview is available using `systemd-analyze security <service>`.
AmbientCapabilities=
CapabilityBoundingSet=
# Uncomment these to allow binding to ports in the range 0-1024.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Process restrictions
NoNewPrivileges=true
RestrictSUIDSGID=true
SecureBits=noroot noroot-locked

# Filesystem protection
ProtectSystem=strict
ProtectHome=true
ProtectProc=noaccess
ProcSubset=pid

# Namespace isolation
PrivateTmp=disconnected
PrivateDevices=true
PrivateIPC=true
#:if SYSTEMD_MAJOR >= 258
PrivateBPF=true
#:endif

# Kernel and system protection
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict

# Execution restrictions
# Python needs writable+executable memory.
MemoryDenyWriteExecute=false
SetLoginEnvironment=false

# System call and network filtering
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

# Cleanup
RemoveIPC=true

[Install]
WantedBy=multi-user.target
