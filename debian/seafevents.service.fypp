# Please consider only editing this file through systemd drop-in files
# (e.g. `systemctl edit seafevents`). This will enable you to get updates
# to this file automatically, without your overrides being lost.

# Refer to the manpage `systemd.unit` for detailed documentation on each option.
[Unit]
Description=Seafile background tasks and event processing (seafevents)
Documentation=https://manual.seafile.com https://github.com/dionysius/seafile-deb
PartOf=seafile.target
After=network.target seaf-server.service seafile-migrate.service seafile.target
Requires=seafile-migrate.service
Wants=seaf-server.service
# A database or cache on this host starts before and stops after this unit.
After=mariadb.service mysql.service redis-server.service memcached.service

# Refer to the manpages `systemd.service` and `systemd.exec` for detailed documentation on each option.
[Service]
SyslogIdentifier=seafevents
## Service execution environment
# Service configuration file.
EnvironmentFile=%E/seafile/seafile.env
# logs to the console instead of log files (seasearch, face recognition)
Environment=SEAFILE_LOG_TO_STDOUT=true
Type=exec
ExecStart=/usr/lib/seahub/venv/bin/python -m seafevents.main --config-file %E/seafile/seafevents.conf
WorkingDirectory=/usr/lib/seahub/seahub
Restart=on-failure
RestartSec=5s

## Permissions and directories
User=seafile
Group=seafile
ConfigurationDirectory=seafile::ro
ConfigurationDirectoryMode=0500
StateDirectory=seafile
StateDirectoryMode=0750
UMask=0027

## Connection and process limits
#TasksMax=128
# Customize limits to your setup and expected usage spikes.
#CPUQuota=200%
#MemoryHigh=1G
#MemoryMax=2G

## Sandboxing and isolation
# An overview is available using `systemd-analyze security <service>`.
AmbientCapabilities=
CapabilityBoundingSet=

# Process restrictions
NoNewPrivileges=true
RestrictSUIDSGID=true
SecureBits=noroot noroot-locked

# Filesystem protection
ProtectSystem=strict
ProtectHome=true
ProtectProc=noaccess
ProcSubset=pid

# Namespace isolation
PrivateTmp=disconnected
PrivateDevices=true
PrivateIPC=true
#:if SYSTEMD_MAJOR >= 258
PrivateBPF=true
#:endif

# Kernel and system protection
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict

# Execution restrictions
# Python needs writable+executable memory.
MemoryDenyWriteExecute=false
SetLoginEnvironment=false

# System call and network filtering
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

# Cleanup
RemoveIPC=true

[Install]
WantedBy=seafile.target
